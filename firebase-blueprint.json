{
  "entities": {
    "Board": {
      "title": "Board",
      "description": "Custom or community-added Raspberry Pi, SBC, MCU, Compute Module, or Alternative board entry in the catalog.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the user who created this board record.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerName": {
          "type": "string",
          "description": "Display name of the contributor.",
          "minLength": 1,
          "maxLength": 100
        },
        "isPublic": {
          "type": "boolean",
          "description": "Whether this board is publicly visible in the shared catalog."
        },
        "boardType": {
          "type": "string",
          "description": "Determines whether this board is listed in official models or alternative SBCs.",
          "enum": ["official", "alternative"]
        },
        "name": {
          "type": "string",
          "description": "Model name of the board.",
          "minLength": 2,
          "maxLength": 120
        },
        "brand": {
          "type": "string",
          "description": "Manufacturer or brand name.",
          "minLength": 1,
          "maxLength": 80
        },
        "badge": {
          "type": "string",
          "description": "Short highlight badge label.",
          "minLength": 1,
          "maxLength": 100
        },
        "badgeColor": {
          "type": "string",
          "description": "Tailwind badge styling classes.",
          "minLength": 1,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "description": "Hardware category.",
          "enum": ["sbc", "zero", "mcu", "keyboard", "compute", "alternative"]
        },
        "releaseDate": {
          "type": "string",
          "description": "Release date label.",
          "minLength": 1,
          "maxLength": 60
        },
        "msrp": {
          "type": "string",
          "description": "Estimated retail price or range.",
          "minLength": 1,
          "maxLength": 80
        },
        "status": {
          "type": "string",
          "description": "Market lifecycle status.",
          "enum": ["Ativo", "Legado", "Foco Educacional", "Industrial"]
        },
        "image": {
          "type": "string",
          "description": "External HTTPS image URL or built-in preset key.",
          "maxLength": 2048
        },
        "imageId": {
          "type": "string",
          "description": "Optional reference ID to a document in the images collection.",
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "description": "Detailed summary and overview of the board.",
          "minLength": 5,
          "maxLength": 1500
        },
        "soc": {
          "type": "string",
          "description": "System-on-Chip identifier.",
          "minLength": 1,
          "maxLength": 150
        },
        "cpu": {
          "type": "string",
          "description": "CPU architecture and clock speed.",
          "minLength": 1,
          "maxLength": 200
        },
        "gpu": {
          "type": "string",
          "description": "GPU or NPU specification.",
          "maxLength": 200
        },
        "npu": {
          "type": "string",
          "description": "AI / NPU acceleration specification for alternative boards.",
          "maxLength": 200
        },
        "ram": {
          "type": "string",
          "description": "Supported memory configurations.",
          "minLength": 1,
          "maxLength": 150
        },
        "storage": {
          "type": "string",
          "description": "Storage interfaces and slots.",
          "minLength": 1,
          "maxLength": 250
        },
        "videoOut": {
          "type": "string",
          "description": "Display output ports and max resolution.",
          "maxLength": 250
        },
        "audio": {
          "type": "string",
          "description": "Audio interfaces.",
          "maxLength": 200
        },
        "networking": {
          "type": "string",
          "description": "Ethernet, Wi-Fi, and Bluetooth connectivity.",
          "minLength": 1,
          "maxLength": 250
        },
        "usb": {
          "type": "string",
          "description": "USB ports summary.",
          "maxLength": 200
        },
        "pcie": {
          "type": "string",
          "description": "PCIe / M.2 expansion details.",
          "maxLength": 200
        },
        "gpio": {
          "type": "string",
          "description": "GPIO header specification.",
          "maxLength": 200
        },
        "power": {
          "type": "string",
          "description": "Recommended power supply.",
          "minLength": 1,
          "maxLength": 150
        },
        "dimensions": {
          "type": "string",
          "description": "Physical dimensions in mm.",
          "maxLength": 120
        },
        "keyFeatures": {
          "type": "array",
          "description": "List of notable features or pros (max 15 items)."
        },
        "cons": {
          "type": "array",
          "description": "List of limitations for alternative boards (max 10 items)."
        },
        "bestFor": {
          "type": "string",
          "description": "Recommended use cases.",
          "maxLength": 400
        },
        "benchmarkScore": {
          "type": "number",
          "description": "Relative performance index from 1 to 100."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of document creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "ownerId",
        "ownerName",
        "isPublic",
        "boardType",
        "name",
        "brand",
        "badge",
        "badgeColor",
        "category",
        "releaseDate",
        "msrp",
        "status",
        "image",
        "description",
        "soc",
        "cpu",
        "ram",
        "storage",
        "networking",
        "power",
        "keyFeatures",
        "benchmarkScore",
        "createdAt",
        "updatedAt"
      ]
    },
    "Accessory": {
      "title": "Accessory",
      "description": "Hardware accessory, HAT, power supply, cooler, storage, camera, or display entry.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the creator.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerName": {
          "type": "string",
          "description": "Display name of the contributor.",
          "minLength": 1,
          "maxLength": 100
        },
        "isPublic": {
          "type": "boolean",
          "description": "Whether this accessory is publicly visible in the catalog."
        },
        "name": {
          "type": "string",
          "description": "Accessory product name.",
          "minLength": 2,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "description": "Accessory category.",
          "enum": ["power", "cooling", "storage", "camera", "display", "hat"]
        },
        "compatibility": {
          "type": "array",
          "description": "List of compatible board models (max 15 items)."
        },
        "msrp": {
          "type": "string",
          "description": "Estimated retail price.",
          "minLength": 1,
          "maxLength": 60
        },
        "specs": {
          "type": "string",
          "description": "Technical specifications.",
          "minLength": 2,
          "maxLength": 400
        },
        "description": {
          "type": "string",
          "description": "Detailed description.",
          "minLength": 5,
          "maxLength": 1000
        },
        "whyNeeded": {
          "type": "string",
          "description": "Explanation of why the accessory is recommended.",
          "minLength": 2,
          "maxLength": 600
        },
        "image": {
          "type": "string",
          "description": "External HTTPS image URL or preset key.",
          "maxLength": 2048
        },
        "imageId": {
          "type": "string",
          "description": "Optional reference ID to a document in the images collection.",
          "maxLength": 128
        },
        "powerDrawWatts": {
          "type": "number",
          "description": "Estimated power consumption in Watts (0 to 100)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "ownerId",
        "ownerName",
        "isPublic",
        "name",
        "category",
        "compatibility",
        "msrp",
        "specs",
        "description",
        "whyNeeded",
        "image",
        "powerDrawWatts",
        "createdAt",
        "updatedAt"
      ]
    },
    "ImageAsset": {
      "title": "ImageAsset",
      "description": "Catalog image asset entry (URL, preset reference, or compressed lightweight WebP preview) reusable across boards and accessories.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the creator.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerName": {
          "type": "string",
          "description": "Display name of the contributor.",
          "minLength": 1,
          "maxLength": 100
        },
        "isPublic": {
          "type": "boolean",
          "description": "Whether this image asset is publicly selectable."
        },
        "title": {
          "type": "string",
          "description": "Human-readable title for the image.",
          "minLength": 2,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "description": "Asset category.",
          "enum": ["board", "accessory", "pinout", "other"]
        },
        "sourceType": {
          "type": "string",
          "description": "How the image is stored or referenced.",
          "enum": ["url", "preset", "compressed"]
        },
        "url": {
          "type": "string",
          "description": "HTTPS URL, preset key, or compressed WebP/JPEG data URI (max 100KB).",
          "minLength": 4,
          "maxLength": 100000
        },
        "altText": {
          "type": "string",
          "description": "Accessible alt text description.",
          "maxLength": 200
        },
        "tags": {
          "type": "array",
          "description": "Search tags (max 8 items)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "ownerId",
        "ownerName",
        "isPublic",
        "title",
        "category",
        "sourceType",
        "url",
        "tags",
        "createdAt",
        "updatedAt"
      ]
    },
    "Admin": {
      "title": "Admin",
      "description": "Explicit admin membership record keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "enum": ["admin"],
          "description": "Admin role marker."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when admin privilege was granted."
        }
      },
      "required": ["role", "createdAt"]
    }
  },
  "firestore": {
    "/boards/{boardId}": {
      "schema": { "$ref": "#/entities/Board" },
      "description": "Collection of manually added and customized SBC/MCU/Alternative boards."
    },
    "/accessories/{accessoryId}": {
      "schema": { "$ref": "#/entities/Accessory" },
      "description": "Collection of manually added and customized hardware accessories."
    },
    "/images/{imageId}": {
      "schema": { "$ref": "#/entities/ImageAsset" },
      "description": "Reusable image gallery database for linking photos to boards and accessories."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Trusted admin allowlist documents keyed by UID."
    }
  }
}
