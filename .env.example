# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# GITHUB_TOKEN: Fine-grained Personal Access Token (Contents: Read and write)
# Enables automatic direct commits to public/database.json on GitHub on every Save.
GITHUB_TOKEN="MY_GITHUB_TOKEN"

# Optional repository override (defaults to Bernas1078/Pi-Universe-Pro)
GITHUB_REPO="Bernas1078/Pi-Universe-Pro"
GITHUB_BRANCH="main"
GITHUB_DB_PATH="public/database.json"
